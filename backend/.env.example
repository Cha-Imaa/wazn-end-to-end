# Copy to backend/.env and fill in K2_API_KEY. Every value here is optional —
# the defaults live in app/core/config.py — but with no key and no flags the
# Insights tab is entirely deterministic, which is a valid way to run the app.
#
# Booleans accept 1 / true / yes / on (case-insensitive); anything else is false.

# --- K2 Think endpoint -------------------------------------------------------

# Required for any live agent. Never commit a real key: backend/.env is ignored.
K2_API_KEY=

K2_BASE_URL=https://api.k2think.ai/v1/chat/completions
K2_MODEL=MBZUAI-IFM/K2-Think-v2

# --- Agent flags -------------------------------------------------------------

# The four agents served on GET /api/insights. Each defaults to false, and a
# disabled agent reports engine_status "skipped" with its block still shaped.
ENABLE_K2_EXPLANATION=false
ENABLE_K2_QUIZ=false
ENABLE_K2_GUARDRAIL_REVIEW=false
ENABLE_K2_EVALUATION=false

# Read into Settings but branched on nowhere — there is no tutor agent. Left
# here so the name is documented rather than mistaken for a missing feature.
ENABLE_K2_TUTOR=false

# Runs the four agents for the demo words at startup, before the app serves
# traffic. Useful locally ahead of a demo; slow, and off in production.
ENABLE_K2_INSIGHTS_PREWARM=false

# Feeds the /api/analyze K2 Think panel mockup-faithful sample content for the
# parts not on that endpoint's path. It is labelled engine_status
# "demo_sample" in the UI; /api/insights never serves it. Defaults to true.
ENABLE_K2_THINK_DEMO=true

# --- Timeouts and limits -----------------------------------------------------

# Per-call ceiling for /api/insights, bounding four sequential agents.
K2_INSIGHTS_TIMEOUT_SECONDS=45

# Completion cap (reasoning + answer) per call. 0 or negative omits the field.
K2_MAX_COMPLETION_TOKENS=32000

# Prompt-lab only (app/prompt_lab/), not the request path.
K2_TIMEOUT_SECONDS=30

# Prompt-lab only: reasoning effort the lab runners send, so a prompt is judged
# at the effort it is served at. Empty means the endpoint's default. The served
# agents set this per-agent in code (AgentSpec.reasoning_effort), not here.
K2_REASONING_EFFORT=medium
